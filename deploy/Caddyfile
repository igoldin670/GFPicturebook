# HTTPS is terminated by Tailscale Serve; this listener stays loopback-only.
:80 {
    @upload path /api/photos/upload/
    handle @upload {
        request_body {
            max_size 50MiB
        }
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        request_body {
            max_size 64KB
        }
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
        }
    }
}
