# Generate real secrets with python3 scripts/init-env.py; never commit .env.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=memories
POSTGRES_USER=memories
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATA_DIR=./data
# Used only for the upload-date fallback; e.g. America/New_York or Europe/London.
LIBRARY_TIME_ZONE=UTC
# Optional, after mounting existing filesystems and configuring container binds:
# STORAGE_DRIVES_FILE=/config/drives.json
STORAGE_FREE_RESERVE_MIB=1024
STORAGE_CHECK_SECONDS=86400
MEDIA_CACHE_MIB=256
MEDIA_WORKER_MEMORY_MIB=8192
# 0 disables the separate photo cap; the shared request ceiling remains.
PHOTO_MAX_MIB=50
VIDEO_MAX_MIB=102400
MEDIA_REQUEST_MAX_MIB=102400
UPLOADS_PER_MINUTE=600
MEDIA_PENDING_LIMIT=1000
UPLOAD_BATCH_LIMIT=1000
MEDIA_PARALLEL_JOBS=3
VIDEO_TRANSCODE=1
VIDEO_TIMEOUT_SECONDS=21600
